    <string name="account_summary_unused">Connected, not used for Lens</string>
    <string name="account_intro">Optional. With your account connected, Lens requests go out signed in: fewer limits, and Lens behaves as it does for you. The cookies are sent only to Google, only from this device. Anyone holding them is signed in as you, so connect only an account you’d use in a browser here.</string>
    <string name="account_storage_encrypted">They are stored encrypted with a key that never leaves this device.</string>
    <string name="account_storage_plain">They are stored in a file in the app’s data folder, readable by your user account.</string>
