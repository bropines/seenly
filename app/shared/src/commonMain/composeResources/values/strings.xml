    <string name="account_paste_desc">A “Cookie:” header copied from a signed-in browser</string>
    <string name="account_paste_hint">In a desktop browser signed in to Google: developer tools → Network → any request to google.com → copy the “Cookie” request header.</string>
    <string name="account_file">Import a cookies file</string>
    <string name="account_file_desc">cookies.txt (Netscape) or JSON from a cookie editor extension; only Google’s cookies are kept</string>
    <string name="account_connect_action">Connect</string>
    <string name="account_connected">Google account connected</string>
    <string name="account_no_session">No signed-in Google session found there (SID and SAPISID cookies are needed)</string>
    <string name="account_refused_title">Google refused the account</string>
    <string name="account_refused">The saved session has expired or was signed out, so Lens requests are anonymous again. Sign in again in Settings → Google account.</string>
    <string name="account_sign_in_refused_title">Google won’t sign in here</string>
    <string name="account_sign_in_refused">Google refuses to sign in from an app’s embedded browser on this device (“This browser or app may not be secure”). Seenly doesn’t disguise itself to get around that. Instead, sign in to Google in a desktop browser, export its cookies and import them here.</string>
