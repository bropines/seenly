<?xml version="1.0" encoding="utf-8"?>
<!-- Seenly's entries in the system share sheet (see ShareShortcuts): a picture shared to one opens in that mode. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="io.github.bropines.lens.MainActivity">
        <data android:mimeType="image/*" />
        <category android:name="io.github.bropines.lens.category.SHARE_IMAGE" />
    </share-target>
</shortcuts>
